# =============================================================================
# FreelanceShield AI - Environment Configuration
# Copy this file to .env and insert your API credentials.
# The platform runs with full fidelity in Sandbox/Heuristic mode even without external keys.
# =============================================================================

# Flask Application Secret
FLASK_SECRET_KEY=freelanceshield-secret-key-2026-liquid-glass
FLASK_DEBUG=True
PORT=5000

# OpenAI API (Optional - Built-in advanced NLP heuristic core activates if absent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# PayPal Developer Sandbox Credentials
# Retrieve from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Database Configuration
DATABASE_URL=sqlite:///freelanceshield.db
